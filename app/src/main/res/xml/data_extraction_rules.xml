<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 ke atas: cadangan awan dan pemindahan antar perangkat membawa database dan pengaturan. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="habitflow.db" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="habitflow.db" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
