# Salin ke ~/.habitflow-ops.env di VM (chmod 600). JANGAN di-commit berisi nilai asli.
# Dibaca oleh backup.sh, restore-drill.sh, dan monitor.sh. Lihat docs/operasional-server.md.

# --- Backup ---
# Folder salinan lokal di VM (cadangan cepat; salinan yang menyelamatkan kalau VM hilang ada di BACKUP_REMOTE).
BACKUP_DIR="$HOME/backups/habitflow"
# Berkas berisi kata sandi enkripsi backup (satu baris, chmod 600). Salinannya disimpan di luar VM (lihat docs).
BACKUP_PASSPHRASE_FILE="$HOME/.habitflow-backup-pass"
# Tujuan di luar VM, format rclone "namaremote:bucket". Wajib. Diputuskan: Cloudflare R2 (rclone config: tipe S3, provider Cloudflare).
BACKUP_REMOTE=""
BACKUP_KEEP_DAYS=30
BACKUP_LOCAL_KEEP_DAYS=7

# --- Container ---
APP_CONTAINER="habitflow"
QUEUE_CONTAINER="habitflow-queue"
MYSQL_CONTAINER="shared-mysql"

# --- Pemberitahuan ---
# Healthchecks.io (atau yang setara): satu URL ping per pekerjaan. Kosongkan kalau belum dipakai.
HC_BACKUP_URL=""
HC_DRILL_URL=""
HC_MONITOR_URL=""
# Peringatan ke ponsel lewat ntfy (https://ntfy.sh/<topik-rahasia>). Kosongkan kalau belum dipakai.
ALERT_URL=""

# --- Pemantauan ---
PUBLIC_URL="https://habitflow.roziqrizal.com/up"
LOCAL_URL="http://127.0.0.1:8081/up"
DISK_MAX_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
# Antrean dianggap macet kalau ada job lebih tua dari ini (detik).
QUEUE_MAX_AGE_SECONDS=900
# Peringatan diulang selama masalah belum pulih, paling sering sekali per jam ini.
ALERT_REPEAT_HOURS=6
