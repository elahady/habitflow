APP_NAME=Habitflow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Tahap 31B: email kode dikirim lewat antrean. Produksi memakai "database" dan service `queue`
# di docker-compose.yml menjalankan `queue:work`. Lokal boleh "sync" (email langsung terkirim).
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Tahap 31B. Lokal: "log" menulis email ke storage/logs. Produksi: Resend lewat SMTP (tanpa paket
# tambahan), pengirim di subdomain khusus mail.roziqrizal.com:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=<API key Resend>
#   MAIL_FROM_ADDRESS="noreply@mail.roziqrizal.com"
# Cadangan Brevo (SMTP, 300 per hari gratis): ganti HOST=smtp-relay.brevo.com, PORT=587,
# SCHEME=null (STARTTLS), USERNAME dan PASSWORD dari halaman SMTP Brevo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mail.roziqrizal.com"
MAIL_FROM_NAME="${APP_NAME}"

# Batas email per hari di paket layanan pengirim (Resend gratis: 100). Pada 80%, pemilik
# diberi tahu satu kali per hari ke OWNER_EMAIL.
MAIL_DAILY_LIMIT=100
OWNER_EMAIL=

# Versi kebijakan privasi yang berlaku. Naikkan kalau isi kebijakan berubah.
PRIVACY_POLICY_VERSION=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Sign-In (tahap 25) - buat Client ID di Google Cloud Console,
# lihat docs/concept.md Tahap 25 langkah 3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/login/google/callback"
# Walau namanya "Android", isinya Client ID tipe WEB yang sama dengan GOOGLE_CLIENT_ID
# di atas - itu yang jadi "aud" di ID token yang dikirim app Android lewat Credential
# Manager (lihat GoogleSignIn.kt: GOOGLE_SERVER_CLIENT_ID di local.properties harus sama).
# Client ID tipe Android (terdaftar dengan package name + SHA-1) tidak pernah ditaruh di
# kode mana pun - cukup terdaftar di Google Cloud Console.
GOOGLE_ANDROID_CLIENT_ID=
PRIVACY_POLICY_EFFECTIVE="12 Oktober 2026"
# Nama dan kontak yang tampil di /kebijakan-privasi dan /hapus-akun. PRIVACY_CONTACT_EMAIL WAJIB
# diisi sebelum rilis (Gerbang C): tanpa itu kebijakan tidak memuat kontak penanggung jawab.
OWNER_NAME="Roziq Rizal"
PRIVACY_CONTACT_EMAIL=
